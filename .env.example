# Copy to .env and fill in. docker compose reads this file automatically.

# Database (local postgres container)
POSTGRES_USER=cog
POSTGRES_PASSWORD=cog
POSTGRES_DB=cog

# Auth — generate SECRET_KEY with: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Orchestrator (chat/LLM feature). Bedrock also needs AWS creds in the backend env.
ORCHESTRATOR_TYPE=langgraph

# Frontend -> backend base URL (as seen from the browser)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
